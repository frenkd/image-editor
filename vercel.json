{
  "rewrites": [
    {
      "source": "/((?!assets/|og\\.png|favicon\\.svg|robots\\.txt|sitemap\\.xml|agents\\.txt|agents\\.json|llms\\.txt|agent-skills/|use-cases/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
